<mvc:View
	controllerName="com.duhamel.gdrivemanager.controller.FileList"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">
	<Page id="listPage" title="{i18n>myFiles}" showNavButton="true" navButtonPress=".onNavBack"
		busy="{list>/busy}" class="gdPage">
		<headerContent>
			<Button icon="sap-icon://palette" tooltip="{i18n>toggleTheme}" press=".onToggleTheme" />
		</headerContent>
		<content>
			<!-- Barre de filtres -->
			<Panel class="gdFilterBar sapUiResponsiveMargin" backgroundDesign="Solid">
				<FlexBox wrap="Wrap" alignItems="End">
					<VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>filterSearch}" labelFor="searchField" />
						<SearchField id="searchField" width="16rem" placeholder="{i18n>searchPlaceholder}"
							liveChange=".onFilterChange" search=".onFilterChange" />
					</VBox>
					<VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>filterType}" labelFor="typeSelect" />
						<Select id="typeSelect" selectedKey="{list>/type}" change=".onFilterChange" width="14rem">
							<core:Item key="all" text="{i18n>filterAll}" />
							<core:Item key="documents" text="{i18n>filterDocuments}" />
							<core:Item key="image" text="{i18n>type.image}" />
							<core:Item key="video" text="{i18n>type.video}" />
							<core:Item key="pdf" text="{i18n>type.pdf}" />
							<core:Item key="office" text="{i18n>type.office}" />
							<core:Item key="google" text="{i18n>type.google}" />
							<core:Item key="text" text="{i18n>type.text}" />
							<core:Item key="folder" text="{i18n>type.folder}" />
							<core:Item key="archive" text="{i18n>type.archive}" />
							<core:Item key="shortcut" text="{i18n>type.shortcut}" />
							<core:Item key="other" text="{i18n>type.other}" />
						</Select>
					</VBox>
					<VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>filterDate}" labelFor="dateRange" />
						<DateRangeSelection id="dateRange" width="15rem" displayFormat="dd/MM/yyyy"
							change=".onFilterChange" />
					</VBox>
					<Button text="{i18n>filterReset}" icon="sap-icon://reset" type="Transparent"
						press=".onResetFilters" class="sapUiTinyMarginBottom" />
				</FlexBox>
			</Panel>

			<!-- Tableau -->
			<Table id="fileTable" items="{path: 'list>/files', sorter: {path: 'modifiedTime', descending: true}}"
				growing="true" growingThreshold="25" sticky="ColumnHeaders,HeaderToolbar"
				noDataText="{i18n>noData}" class="sapUiResponsiveMargin gdTable" width="auto">
				<headerToolbar>
					<OverflowToolbar>
						<Title text="{i18n>filesTitle} ({list>/count})" level="H2" />
						<ToolbarSpacer />
						<Button icon="sap-icon://refresh" text="{i18n>refresh}" type="Transparent" press=".onRefresh" />
						<Button icon="sap-icon://upload-to-cloud" text="{i18n>upload}" type="Emphasized"
							press=".onUploadPress" />
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column><Text text="{i18n>colName}" /></Column>
					<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colType}" /></Column>
					<Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colSize}" /></Column>
					<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colModified}" /></Column>
					<Column hAlign="End" width="4rem"><Text text="" /></Column>
				</columns>
				<items>
					<ColumnListItem type="Navigation" press=".onItemPress" vAlign="Middle">
						<cells>
							<HBox alignItems="Center">
								<core:Icon src="{list>typeIcon}" size="1.5rem" class="sapUiSmallMarginEnd gdFileIcon" />
								<Link text="{list>name}" press=".onItemPress" />
							</HBox>
							<ObjectStatus text="{list>typeText}" state="Information" />
							<Text text="{path: 'list>size', formatter: '.formatter.fileSize'}" />
							<Text text="{path: 'list>modifiedTime', formatter: '.formatter.dateTime'}" />
							<MenuButton icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>actions}">
								<menu>
									<Menu itemSelected=".onMenuAction">
										<MenuItem text="{i18n>viewDetails}" icon="sap-icon://show">
											<customData><core:CustomData key="action" value="detail" /></customData>
										</MenuItem>
										<MenuItem text="{i18n>edit}" icon="sap-icon://edit">
											<customData><core:CustomData key="action" value="rename" /></customData>
										</MenuItem>
										<MenuItem text="{i18n>download}" icon="sap-icon://download">
											<customData><core:CustomData key="action" value="download" /></customData>
										</MenuItem>
										<MenuItem text="{i18n>delete}" icon="sap-icon://delete" startsSection="true">
											<customData><core:CustomData key="action" value="delete" /></customData>
										</MenuItem>
									</Menu>
								</menu>
							</MenuButton>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>